# S6 hermes clotho cron, played back from casts/take_cron.cast (16x9). Generated by make_tapes.sh; see ../script.md for the beat, caption and voiceover.
# theme: ../theme/clotho-theme.json
# Needs the variables render.sh exports (CL_TAPES, CL_REPO, CL_HOME, CL_STAGE, CL_TRASH, CL_SINK_PORT, CL_PLUGIN).
Output s6_cron_16x9.mp4
Set Shell "bash"
Set FontFamily "Dank Mono"
Set FontSize 44
Set Width 1600
Set Height 900
Set Padding 48
Set LineHeight 1.25
Set Framerate 30
Set TypingSpeed 45ms
Set CursorBlink false
Set Theme {"name":"Clotho","black":"#2C2C2B","red":"#E2462F","green":"#CECAC2","yellow":"#DBD7CF","blue":"#B0ACA6","magenta":"#C1BDB6","cyan":"#B8B5AE","white":"#CAC6BE","brightBlack":"#8A8883","brightRed":"#E2462F","brightGreen":"#E0DBD3","brightYellow":"#E6E2D9","brightBlue":"#C1BDB6","brightMagenta":"#D3CEC6","brightCyan":"#CAC6BE","brightWhite":"#EDE8DF","background":"#121212","foreground":"#EDE8DF","selection":"#42413F","cursor":"#EDE8DF"}
Hide
Type `source "$CL_TAPES/env.sh"`
Enter
Sleep 600ms
Type `clear`
Enter
Sleep 300ms
Type `clear; asciinema play -q -i 1.0 "$CL_STAGE/casts/take_cron.cast"; printf '\033[?25l\033[8m%s\033[0m' cast-done; read -rs _`
Enter
Show
# the cast ends, then a concealed marker is printed: VHS 0.12.1 Wait+Screen reads the top of the buffer, not
# the scrolled view, so the wait is on the cursor line (tested 2026-11-10)
Wait+Line@240s /cast-done/
Sleep 3s
Hide
Enter
