# S4 hermes clotho demo: a recorded real fork, replayed; comparison and Apply run for real (16x9). Generated by make_tapes.sh; see ../script.md for the beat, caption and voiceover.
# theme: ../theme/clotho-theme.json
# Needs the variables render.sh exports (CL_TAPES, CL_REPO, CL_HOME, CL_STAGE, CL_TRASH, CL_SINK_PORT, CL_PLUGIN).
Output s4_fork_16x9.mp4
Set Shell "bash"
Set FontFamily "Dank Mono"
Set FontSize 44
Set Width 1600
Set Height 900
Set Padding 48
Set LineHeight 1.25
Set Framerate 30
Set TypingSpeed 45ms
Set CursorBlink false
Set Theme {"name":"Clotho","black":"#2C2C2B","red":"#E2462F","green":"#CECAC2","yellow":"#DBD7CF","blue":"#B0ACA6","magenta":"#C1BDB6","cyan":"#B8B5AE","white":"#CAC6BE","brightBlack":"#8A8883","brightRed":"#E2462F","brightGreen":"#E0DBD3","brightYellow":"#E6E2D9","brightBlue":"#C1BDB6","brightMagenta":"#D3CEC6","brightCyan":"#CAC6BE","brightWhite":"#EDE8DF","background":"#121212","foreground":"#EDE8DF","selection":"#42413F","cursor":"#EDE8DF"}
Hide
Type `source "$CL_TAPES/env.sh"`
Enter
Sleep 600ms
Type `exec > >(tee "$CL_STAGE/s4_16x9.ansi"); clear`
Enter
Sleep 600ms
Show
Type `hermes clotho demo --dir demo`
Sleep 500ms
Enter
Wait+Line@90s /^[$] *$/
Sleep 1s
Hide
Type `exec > /dev/tty`
Enter
Sleep 300ms
Hide
Type `page "$CL_STAGE/s4_16x9.ansi" '^── [^ ]+ demo ─' 10 0 1`
Enter
Sleep 400ms
Show
Sleep 3s
Hide
Enter
Sleep 200ms
Hide
Type `page "$CL_STAGE/s4_16x9.ansi" '^[^ ]+ fork  f-' 12 0 1`
Enter
Sleep 400ms
Show
Sleep 3s
Hide
Enter
Sleep 200ms
Hide
Type `page "$CL_STAGE/s4_16x9.ansi" '^differences [(]' 13 0 1`
Enter
Sleep 400ms
Show
Sleep 3.5s
Hide
Enter
Sleep 200ms
Hide
Type `page "$CL_STAGE/s4_16x9.ansi" 'what each timeline would do' 14 1 1`
Enter
Sleep 400ms
Show
Sleep 4s
Hide
Enter
Sleep 200ms
Hide
Type `page "$CL_STAGE/s4_16x9.ansi" '── apply claude-sonnet' 8 0 1`
Enter
Sleep 400ms
Show
Sleep 3.5s
Hide
Enter
Sleep 200ms
Hide
Type `page "$CL_STAGE/s4_16x9.ansi" '── the folder afterwards' 6 0 1`
Enter
Sleep 400ms
Show
Sleep 2.5s
Hide
Enter
Sleep 200ms
