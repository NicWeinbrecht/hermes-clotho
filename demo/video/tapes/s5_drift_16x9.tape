# S5 drift: a file changed by hand stops Apply before any change (no model call) (16x9). Generated by make_tapes.sh; see ../script.md for the beat, caption and voiceover.
# theme: ../theme/clotho-theme.json
# Needs the variables render.sh exports (CL_TAPES, CL_REPO, CL_HOME, CL_STAGE, CL_TRASH, CL_SINK_PORT, CL_PLUGIN).
Output s5_drift_16x9.mp4
Set Shell "bash"
Set FontFamily "Dank Mono"
Set FontSize 44
Set Width 1600
Set Height 900
Set Padding 48
Set LineHeight 1.25
Set Framerate 30
Set TypingSpeed 45ms
Set CursorBlink false
Set Theme {"name":"Clotho","black":"#2C2C2B","red":"#E2462F","green":"#CECAC2","yellow":"#DBD7CF","blue":"#B0ACA6","magenta":"#C1BDB6","cyan":"#B8B5AE","white":"#CAC6BE","brightBlack":"#8A8883","brightRed":"#E2462F","brightGreen":"#E0DBD3","brightYellow":"#E6E2D9","brightBlue":"#C1BDB6","brightMagenta":"#D3CEC6","brightCyan":"#CAC6BE","brightWhite":"#EDE8DF","background":"#121212","foreground":"#EDE8DF","selection":"#42413F","cursor":"#EDE8DF"}
Hide
Type `source "$CL_TAPES/env.sh"`
Enter
Sleep 600ms
Output s5_drift_16x9.txt
Type `restore_take a team-notes && cd team-notes && clear`
Enter
Sleep 1.5s
Show
Type `echo "- [ ] call the printer guy" >> todo.md`
Enter
Sleep 1.2s
Type `hermes clotho apply`
Sleep 400ms
Enter
# DEPENDS: the wording of the drift line ("changed since the ...") is apply.py/report.py output
Wait+Line@60s /^[$] *$/
Sleep 3s
Type `echo "exit $?"`
Enter
Sleep 2s
