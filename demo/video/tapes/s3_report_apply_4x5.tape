# S3 report, untick one effect, Apply (no model call) (4x5). Generated by make_tapes.sh; see ../script.md for the beat, caption and voiceover.
# theme: ../theme/clotho-theme.json
# Needs the variables render.sh exports (CL_TAPES, CL_REPO, CL_HOME, CL_STAGE, CL_TRASH, CL_SINK_PORT, CL_PLUGIN).
Output s3_report_apply_4x5.mp4
Set Shell "bash"
Set FontFamily "Dank Mono"
Set FontSize 30
Set Width 1080
Set Height 1000
Set Padding 30
Set LineHeight 1.25
Set Framerate 30
Set TypingSpeed 45ms
Set CursorBlink false
Set Theme {"name":"Clotho","black":"#2C2C2B","red":"#E2462F","green":"#CECAC2","yellow":"#DBD7CF","blue":"#B0ACA6","magenta":"#C1BDB6","cyan":"#B8B5AE","white":"#CAC6BE","brightBlack":"#8A8883","brightRed":"#E2462F","brightGreen":"#E0DBD3","brightYellow":"#E6E2D9","brightBlue":"#C1BDB6","brightMagenta":"#D3CEC6","brightCyan":"#CAC6BE","brightWhite":"#EDE8DF","background":"#121212","foreground":"#EDE8DF","selection":"#42413F","cursor":"#EDE8DF"}
Hide
Type `source "$CL_TAPES/env.sh"`
Enter
Sleep 600ms
Output s3_report_apply_4x5.txt
Type `restore_take a team-notes && sink_start && cd team-notes && clear`
Enter
Sleep 1.5s
Show
Type `hermes clotho report | less`
Enter
Sleep 5s
Space
Sleep 4s
Space
Sleep 3s
Type "q"
Sleep 300ms
Ctrl+L
Sleep 400ms
# DEPENDS ON TAKE A: @EXCEPT@ is the number of the "delete scratch.tmp" row; render.sh fills it from the ledger
Type `hermes clotho apply --except @EXCEPT@`
Sleep 500ms
Enter
Wait+Line@60s /^[$] *$/
Sleep 3s
Type `sink`
Enter
Sleep 2.5s
Type `ls`
Enter
Sleep 2.5s
Hide
Type `sink_stop`
Enter
Sleep 300ms
