  "captions": [
    {"id": "c01", "from": 0.00, "to": 2.00, "text": "3 models, 1 messy Downloads folder"},
    {"id": "c02", "from": 2.00, "to": 3.80, "text": "2 of them deleted resume_v3_final.docx"},
    {"id": "c03", "from": 3.80, "to": 5.60, "text": "None of it happened."},
    {"id": "c04", "from": 6.00, "to": 9.40, "text": "In Greek myth, three Fates spin, measure\nand cut the thread of every life."},
    {"id": "c05", "from": 11.40, "to": 15.70, "text": "Nous named its RL framework Atropos:\nthe Fate who cuts."},
    {"id": "c06", "from": 15.70, "to": 18.90, "text": "Clotho is her sister. She spins."},
    {"id": "c07", "from": 18.90, "to": 23.30, "text": "A Hermes Agent plugin that spins every\npossible future of an agent task,"},
    {"id": "c08", "from": 23.30, "to": 26.40, "text": "lets you measure them, and keeps only the one you choose."},
    {"id": "c09", "from": 26.40, "to": 33.60, "text": "Every side effect goes into a ledger. Nothing happens yet."},
    {"id": "c10", "from": 33.60, "to": 35.60, "text": "Untick the delete. Keep the rest."},
    {"id": "c11", "from": 35.60, "to": 38.00, "text": "Apply: only what you kept · 0 model calls"},
    {"id": "c12", "from": 38.00, "to": 40.30, "text": "The webhook got the summary. scratch.tmp is still there."},
    {"id": "c13", "from": 40.30, "to": 43.60, "text": "Fork: same task, 3 models, 3 futures at once"},
    {"id": "c14", "from": 43.60, "to": 46.50, "text": "The ledgers, compared: 56 differences"},
    {"id": "c15", "from": 46.50, "to": 48.70, "text": "Deletes: 29 · 51 · 32. Precious files lost: 1 · 1 · 0"},
    {"id": "c16", "from": 48.70, "to": 50.50, "text": "Keep the one that lost nothing: 130 effects, 0 model calls"},
    {"id": "c17", "from": 50.50, "to": 52.40, "text": "10 of 10 precious files kept"},
    {"id": "c18", "from": 52.40, "to": 54.60, "text": "A real fork, recorded and replayed:\nno key, nothing leaves the machine"},
    {"id": "c19", "from": 54.60, "to": 57.20, "text": "Changed a file by hand?\nApply stops before it changes anything."},
    {"id": "c20", "from": 57.20, "to": 59.35, "text": "Drift stopped 14 of 14 times in my tests"},
    {"id": "c21a", "from": 59.35, "to": 61.40, "text": "cron: spin a scheduled job before it runs on its own."},
    {"id": "c21b", "from": 61.40, "to": 63.50, "text": "Delivery held, job state untouched."},
    {"id": "c22", "from": 63.70, "to": 71.50, "text": "69 of 72 runs passed every check ·\nthe 3 misses are listed in EVAL.md"}
